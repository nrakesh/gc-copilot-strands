# GC2 Copilot Strands - Environment Configuration

# ============================================================================
# LLM Provider Selection
# ============================================================================

# LLM Provider - Choose "openai" or "anthropic" (default: openai)
LLM_PROVIDER=openai

# ============================================================================
# OpenAI Configuration (if LLM_PROVIDER=openai)
# ============================================================================

# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model - Default: gpt-4o
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, o1-preview, o1-mini
OPENAI_MODEL=gpt-4o

# ============================================================================
# Anthropic Configuration (if LLM_PROVIDER=anthropic)
# ============================================================================

# Anthropic API Key - Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude Model - Default: claude-sonnet-4-5-20250929
# Options: claude-sonnet-4-5-20250929, claude-opus-4-20250514
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# ============================================================================
# ChromaDB Configuration
# ============================================================================

# ChromaDB directory (relative to project root)
CHROMA_DIR=chroma_db

# Embedding model for sentence transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================================================
# Retry Configuration (for API resilience)
# ============================================================================

# Maximum number of retry attempts for API calls (default: 3)
MAX_RETRIES=3

# Initial delay in seconds before first retry (default: 2.0)
INITIAL_RETRY_DELAY=2.0

# Maximum delay in seconds between retries (default: 60.0)
MAX_RETRY_DELAY=60.0

# ============================================================================
# Notes
# ============================================================================

# 1. Copy this file to .env and add your actual API key
# 2. The retry settings help handle transient API errors like "Overloaded"
# 3. Increase MAX_RETRIES if you frequently encounter API rate limits
# 4. Adjust INITIAL_RETRY_DELAY and MAX_RETRY_DELAY for exponential backoff tuning
